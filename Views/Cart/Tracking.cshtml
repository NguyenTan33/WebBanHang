@model IEnumerable<WebBanHang.Models.Order>
@{
    ViewData["Title"] = "Theo dõi đơn hàng";
}

<div class="container mt-5" style="max-width: 900px;">
    <h2 class="text-center fw-bold mb-4 text-success"><i class="bi bi-search"></i> KIỂM TRA ĐƠN HÀNG</h2>

    <div class="card border-0 shadow-sm mb-5" style="border-radius: 15px;">
        <div class="card-body p-4">
            <form method="get" asp-action="Tracking" class="row g-2">
                <div class="col-md-9">
                    <input type="text" name="phone" class="form-control form-control-lg rounded-pill px-4"
                           placeholder="Nhập số điện thoại đã đặt hàng..." value="@ViewBag.Phone" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold">TRA CỨU</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="card mb-4 border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted small">Mã đơn hàng:</span>
                            <span class="fw-bold text-primary">#@item.Id</span>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small">Ngày đặt:</span><br />
                            <span class="small">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-3 d-flex align-items-center justify-content-between">
                        <span class="fw-bold">Trạng thái:</span>
                        @switch (item.Status)
                        {
                            case 0:
                                <span class="badge bg-secondary p-2 px-3 rounded-pill"><i class="bi bi-box"></i> Vừa đặt (Chờ duyệt)</span>
                                break;
                            case 1:
                                <span class="badge bg-info p-2 px-3 rounded-pill text-dark"><i class="bi bi-qr-code"></i> Đã thanh toán (QR)</span>
                                break;
                            case 2:
                                <span class="badge bg-warning p-2 px-3 rounded-pill text-dark"><i class="bi bi-gear-wide-connected"></i> Đang soạn đơn</span>
                                break;
                            case 3:
                                <span class="badge bg-success p-2 px-3 rounded-pill"><i class="bi bi-check-all"></i> Giao thành công</span>
                                break;
                            case 4:
                                <span class="badge bg-danger p-2 px-3 rounded-pill"><i class="bi bi-x-circle"></i> Đã hủy</span>
                                break;
                        }
                    </div>

                    <div class="row small text-muted">
                        <div class="col-6">Họ tên: <strong>@item.FullName</strong></div>
                        <div class="col-6 text-end">Tổng tiền: <strong class="text-danger fs-5">@item.TotalAmount.ToString("N0")₫</strong></div>
                        <div class="col-12 mt-1">Địa chỉ: @item.Address</div>
                    </div>
                </div>
            </div>
        }
    }
    else if (!string.IsNullOrEmpty(ViewBag.Phone))
    {
        <div class="text-center py-5">
            <i class="bi bi-emoji-frown fs-1 text-muted"></i>
            <p class="mt-3 text-muted">Không tìm thấy đơn hàng nào cho số điện thoại này !</p>
        </div>
    }
</div>
<a asp-controller="Home" asp-action="Index" asp-route-id="5" class="btn btn-info">Về Trang Chủ</a>