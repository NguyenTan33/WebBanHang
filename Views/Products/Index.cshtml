@model IEnumerable<WebBanHang.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "_Layout_Admin"; // Đảm bảo tên này khớp với file trong Views/Shared
}

@section Styles {
    <style>
        /* 1. STAT CARDS */
        .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
        .stat-card { background: #fff; border-radius: 13px; padding: 16px 18px; box-shadow: 0 1px 10px rgba(0,0,0,.06); display: flex; align-items: center; gap: 13px; }
        .stat-icon { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
        .si-green { background: var(--green-light); color: var(--green-main); }
        .si-yellow { background: #fff8e1; color: #d97706; }
        .si-red { background: #fff0f0; color: var(--red); }
        .si-blue { background: #eff6ff; color: #3b82f6; }
        .stat-num { font-size: 24px; font-weight: 900; color: #111; line-height: 1; }
        .stat-lbl { font-size: 12px; color: #999; font-weight: 500; margin-top: 3px; }

        /* 2. TABLE CARD */
        .tcard { background: #fff; border-radius: 14px; box-shadow: 0 2px 16px rgba(0,0,0,.07); overflow: hidden; }
        .tcard-head { padding: 16px 22px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f0f0f0; flex-wrap: wrap; gap: 12px; }
        .tcard-title { font-size: 15px; font-weight: 800; color: #1a1a1a; display: flex; align-items: center; gap: 7px; }
        .tcard-title i { color: var(--green-main); }

        /* Search & Add Button */
        .search-box { position: relative; }
        .search-box input { padding: 8px 14px 8px 36px; border: 1.5px solid #e8e8e8; border-radius: 20px; font-size: 13px; outline: none; width: 220px; transition: all .2s; }
        .search-box input:focus { border-color: var(--green-main); box-shadow: 0 0 0 3px rgba(44,158,71,.1); }
        .search-box i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #bbb; font-size: 13px; }
        .btn-add { background: linear-gradient(135deg, var(--green-main), var(--green-accent)); color: #fff; border: none; border-radius: 20px; padding: 8px 18px; font-size: 13px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 3px 10px rgba(44,158,71,.28); }

        /* Table Styles */
        .ptable { width: 100%; border-collapse: collapse; }
        .ptable thead tr { background: #fafafa; border-bottom: 2px solid #f0f0f0; }
        .ptable thead th { padding: 11px 16px; font-size: 11px; font-weight: 800; color: #aaa; text-transform: uppercase; letter-spacing: .8px; }
        .ptable tbody tr { border-bottom: 1px solid #f7f7f7; transition: background .12s; }
        .ptable tbody tr:hover { background: #fafffe; }
        .ptable tbody td { padding: 12px 16px; font-size: 13px; vertical-align: middle; }

        .prod-img { width: 54px; height: 54px; border-radius: 10px; object-fit: cover; border: 1.5px solid #eee; }
        .prod-img-placeholder { width: 54px; height: 54px; border-radius: 10px; background: var(--green-light); display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .id-chip { background: #f2f2f2; color: #999; border-radius: 6px; padding: 2px 8px; font-size: 11.5px; font-weight: 700; }
        .price { font-size: 14px; font-weight: 900; color: var(--red); }
        .amt { display: inline-flex; align-items: center; gap: 4px; border-radius: 20px; padding: 3px 10px; font-size: 12px; font-weight: 700; }
        .amt-ok { background: var(--green-light); color: var(--green-dark); }
        .amt-low { background: #fff8e1; color: #b45309; }
        .amt-out { background: #fff0f0; color: var(--red); }

        /* Actions */
        .actions { display: flex; gap: 5px; }
        .btn-act { width: 32px; height: 32px; border-radius: 8px; border: none; display: flex; align-items: center; justify-content: center; transition: all .15s; text-decoration: none; }
        .btn-act:hover { transform: scale(1.1); }
        .btn-edit { background: #eff6ff; color: #3b82f6; }
        .btn-detail { background: #fefce8; color: #b45309; }
        .btn-del { background: #fff0f0; color: var(--red); }

        /* Pagination */
        .pagination-bar { padding: 13px 22px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f0f0f0; color: #aaa; font-size: 13px; }
        .page-btns { display: flex; gap: 4px; }
        .pbtn { width: 32px; height: 32px; border-radius: 8px; border: 1.5px solid #eee; background: #fff; color: #666; display: flex; align-items: center; justify-content: center; text-decoration: none; }
        .pbtn.active { background: var(--green-main); color: #fff; border-color: var(--green-main); }

        /* Modal Delete */
        .modal-bg { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 300; align-items: center; justify-content: center; }
        .modal-bg.open { display: flex; }
        .modal-box { background: #fff; border-radius: 18px; padding: 30px; max-width: 370px; width: 90%; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,.2); }
        .mbtn-cancel { padding: 10px 20px; border-radius: 20px; border: 1px solid #ddd; background: #fff; cursor: pointer; }
        .mbtn-del { padding: 10px 20px; border-radius: 20px; border: none; background: var(--red); color: #fff; cursor: pointer; }
    </style>
}

@{
    int total = Model.Count();
    int outOf = Model.Count(p => p.Amount == 0);
    int lowOf = Model.Count(p => p.Amount > 0 && p.Amount <= 10);
    decimal max = Model.Any() ? Model.Max(p => p.Price) : 0;
}

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon si-green"><i class="bi bi-box-seam-fill"></i></div>
        <div>
            <div class="stat-num">@total</div>
            <div class="stat-lbl">Tổng sản phẩm</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-yellow"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <div>
            <div class="stat-num">@lowOf</div>
            <div class="stat-lbl">Sắp hết hàng</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-red"><i class="bi bi-x-circle-fill"></i></div>
        <div>
            <div class="stat-num">@outOf</div>
            <div class="stat-lbl">Hết hàng</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-blue"><i class="bi bi-currency-exchange"></i></div>
        <div>
            <div class="stat-num" style="font-size:17px;">@max.ToString("N0")₫</div>
            <div class="stat-lbl">Giá cao nhất</div>
        </div>
    </div>
</div>

<div class="tcard">
    <div class="tcard-head">
        <div class="tcard-title">
            <i class="bi bi-list-ul"></i> Danh sách sản phẩm
        </div>
        <div style="display:flex;align-items:center;gap:10px;">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="searchInput" placeholder="Tìm sản phẩm..." oninput="filterRows()" />
            </div>
            <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Thêm mới</a>
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="ptable" id="prodTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th style="text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="id-chip">#@item.Id</span></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Image))
                            {
                                <img src="@item.Image" class="prod-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="prod-img-placeholder" style="display:none;">🛒</div>
                            }
                            else
                            {
                                <div class="prod-img-placeholder">🛒</div>
                            }
                        </td>
                        <td><div class="prod-name">@item.Name</div></td>
                        <td><span class="price">@item.Price.ToString("N0")₫</span></td>
                        <td>
                            @if (item.Amount == 0) { <span class="amt amt-out">Hết hàng</span> }
                            else if (item.Amount <= 10) { <span class="amt amt-low">Còn @item.Amount</span> }
                            else { <span class="amt amt-ok">@item.Amount</span> }
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-act btn-edit"><i class="bi bi-pencil-fill"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-act btn-detail"><i class="bi bi-eye-fill"></i></a>
                                <button class="btn-act btn-del" onclick="openDelete(@item.Id, '@item.Name')"><i class="bi bi-trash3-fill"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal-bg" id="delModal">
    <div class="modal-box">
        <div class="modal-emoji">🗑️</div>
        <div class="modal-title">Xác nhận xoá</div>
        <p class="modal-desc">Bạn có chắc muốn xoá <strong id="delName"></strong>?</p>
        <div class="modal-btns">
            <button class="mbtn-cancel" onclick="closeDelete()">Huỷ</button>
            <form asp-action="Delete" method="post" style="display:inline;">
                <input type="hidden" name="id" id="delId" />
                <button type="submit" class="mbtn-del">Xoá ngay</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterRows() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('#prodTable tbody tr').forEach(r => {
                r.style.display = r.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }
        function openDelete(id, name) {
            document.getElementById('delId').value = id;
            document.getElementById('delName').textContent = name;
            document.getElementById('delModal').classList.add('open');
        }
        function closeDelete() {
            document.getElementById('delModal').classList.remove('open');
        }
        @if (TempData["Success"] != null) { <text>showToast('@TempData["Success"]');</text> }
    </script>
}