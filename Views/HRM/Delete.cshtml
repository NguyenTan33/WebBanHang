@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Xác nhận xóa";
    Layout = "_Layout_HRM";
}

<div style="max-width: 500px; margin: 50px auto; text-align: center;">
    <div style="background: #fff; padding: 40px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        <div style="width: 80px; height: 80px; background: #fff0f0; color: #e82828; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40px; margin: 0 auto 20px;">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        
        <h3 style="font-weight: 800; color: #333;">Xác nhận xóa?</h3>
        <p style="color: #888; font-size: 14px; line-height: 1.6;">
            Bạn đang yêu cầu xóa tài khoản <strong>@Model.UserName</strong>.<br />
            Hành động này không thể hoàn tác. Nhân viên sẽ mất toàn bộ quyền truy cập hệ thống.
        </p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn" style="background: #dc3545; color: #fff; border-radius: 25px; padding: 12px; font-weight: 700;">
                    ĐỒNG Ý XÓA TÀI KHOẢN
                </button>
                <a asp-action="Index" class="btn" style="background: #f5f5f5; color: #666; border-radius: 25px; padding: 12px; font-weight: 700;">
                    HỦY THAO TÁC
                </a>
            </div>
        </form>
    </div>
</div>