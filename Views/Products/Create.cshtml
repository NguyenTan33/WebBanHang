@model WebBanHang.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "_Layout_Admin";
}

@section Styles {
    <style>
        .form-container {
            max-width: 850px;
            margin: 0 auto;
        }
        
        .tcard {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 16px rgba(0,0,0,.07);
            border: none;
            overflow: hidden;
        }

        .tcard-head {
            padding: 20px 25px;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tcard-title {
            font-size: 18px;
            font-weight: 800;
            color: var(--green-dark);
            margin: 0;
        }

        .tcard-body {
            padding: 30px 25px;
        }

        .form-label {
            font-size: 12px;
            font-weight: 700;
            color: #666;
            margin-bottom: 8px;
            display: block;
            text-transform: uppercase;
        }

        /* Style cho cả Input và Select */
        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #ececec;
            padding: 11px 15px;
            font-size: 14px;
            background-color: #fafafa;
            transition: all 0.2s;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--green-main);
                background-color: #fff;
                box-shadow: 0 0 0 4px rgba(44, 158, 71, 0.1);
                outline: none;
            }

        .btn-submit {
            background: linear-gradient(135deg, var(--green-main), var(--green-accent));
            color: #fff;
            border: none;
            border-radius: 25px;
            padding: 13px;
            font-weight: 700;
            width: 100%;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(44, 158, 71, 0.3);
            transition: all 0.2s;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(44, 158, 71, 0.4);
                color: #fff;
            }

        .img-preview {
            width: 120px;
            height: 120px;
            border-radius: 12px;
            border: 2px dashed #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 10px;
            background: #f9f9f9;
            overflow: hidden;
        }
    </style>
}

<div class="form-container">
    <a asp-action="Index" class="btn-back" style="text-decoration:none; color:#888; font-weight:600; display:inline-block; margin-bottom:15px;">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>

    <div class="tcard">
        <div class="tcard-head">
            <i class="bi bi-plus-circle-fill" style="color: var(--green-main); font-size: 20px;"></i>
            <h1 class="tcard-title">Cấu hình sản phẩm mới</h1>
        </div>

        <div class="tcard-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-7 mb-4">
                        <label asp-for="Name" class="form-label">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Thịt heo ba rọi..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-5 mb-4">
                        <label class="form-label">Loại hàng (Category) <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                            <option value="">-- Chọn phân loại --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="Price" class="form-label">Giá bán (VNĐ)</label>
                        <div class="input-group">
                            <input asp-for="Price" class="form-control" type="number" />
                            <span class="input-group-text">₫</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="Amount" class="form-label">Số lượng nhập kho</label>
                        <input asp-for="Amount" class="form-control" type="number" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-4">
                        <label asp-for="Image" class="form-label">Link hình ảnh</label>
                        <input asp-for="Image" class="form-control" id="imgInput" placeholder="Dán URL ảnh tại đây..." />
                        
                        <div class="img-preview">
                            <img id="imgDisplay" src="" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                            <i id="imgIcon" class="bi bi-image" style="color: #ccc; font-size: 28px;"></i>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> TẠO SẢN PHẨM NGAY
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Xử lý xem trước ảnh
        document.getElementById('imgInput').addEventListener('input', function() {
            const url = this.value.trim();
            const display = document.getElementById('imgDisplay');
            const icon = document.getElementById('imgIcon');
            
            if (url) {
                display.src = url;
                display.style.display = 'block';
                icon.style.display = 'none';
            } else {
                display.style.display = 'none';
                icon.style.display = 'block';
            }
        });
    </script>
}